# ===========================================
# Lakehouse Explorer - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# Never commit .env to Git!

# ----- Application Settings -----
APP_NAME=LakehouseExplorer
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# ----- AWS Credentials -----
# These will be validated on first API call
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-lakehouse-bucket

# ----- MinIO (Local S3) -----
# For local testing without AWS
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=lakehouse

# ----- Trino Configuration (Phase 7) -----
# Trino runs in Docker - these are container network values
# For external access, use localhost:8082
TRINO_HOST=trino
TRINO_PORT=8080
TRINO_USER=admin

# ----- Spark Configuration (Phase 6) -----
# Spark cluster runs in Docker
SPARK_MASTER_URL=spark://spark-master:7077

# ----- LLM Configuration (Phase 7.5 - Natural Language Queries) -----
# Get your free API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.1
GROQ_MAX_TOKENS=2000

# ----- API Server -----
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# ----- Security -----
# Generate with: openssl rand -hex 32
SECRET_KEY=your_secret_key_here_generate_with_openssl
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ----- Feature Flags -----
ENABLE_MCP=true
ENABLE_LLM=false
ENABLE_METRICS=true
